{
  "name": "web-react",
  "version": "0.0.1",
  "private": true,
  "description": "web pet projects",
  "author": "Bichi Kim <bichi@live.co.kr>",
  "workspaces": [
    "./packages/*",
    "./coong/*",
    "./docs/*"
  ],
  "scripts": {
    "clean:node_modules": "lerna clean --yes && rimraf node_modules",
    "format:package.json": "npx sort-package-json \"package.json\" \"packages/*/package.json\" \"apps/*/package.json\" ",
    "install:no-scripts": "pnpm i --ignore-scripts",
    "lint": "oxlint -c oxlint.config.js .",
    "lint:fix": "oxlint -c oxlint.config.js --fix .",
    "publish:alpha": "lerna publish from-package --preid alpha --dist-tag alpha",
    "publish:beta": "lerna publish from-package --preid beta --dist-tag beta",
    "publish:next": "lerna publish from-package --preid next --dist-tag next",
    "publish:patch": "lerna publish from-package",
    "start:local-docker": "docker-compose up -d",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "version:alpha": "lerna version prerelease --preid alpha",
    "version:beta": "lerna version prerelease --preid beta",
    "version:next": "lerna version prerelease --preid next",
    "version:patch": "lerna version patch",
    "version:patch-force": "lerna version patch --force-publish",
    "postinstall": "pnpm run -r --sort --filter=@web-react/* build"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "devDependencies": {
    "@babel/core": "7.17.8",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.18.10",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-react": "7.16.7",
    "@babel/preset-typescript": "7.16.7",
    "@storybook/addon-links": "10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@storybook/storybook-deployer": "2.8.12",
    "@testing-library/dom": "8.19.0",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.3.0",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.4.3",
    "@types/lodash": "4.14.180",
    "@types/node": "17.0.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sinon": "10.0.11",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "5.16.0",
    "@typescript-eslint/parser": "5.16.0",
    "@web-react/oxlint-plugins": "workspace:*",
    "@winter-love/vite-plugin-monorepo-alias": "^1.0.37",
    "babel-plugin-htm": "3.0.0",
    "babel-plugin-module-resolver": "4.1.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "builtin-modules": "3.2.0",
    "esbuild-plugin-text-replace": "^1.2.0",
    "eslint": "8.11.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "2.7.0",
    "eslint-plugin-import": "2.25.4",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "6.0.0",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sort-export-all": "^1.2.2",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-typescript-sort-keys": "2.1.0",
    "eslint-plugin-unicorn": "41.0.1",
    "flush-promises": "^1.0.2",
    "jsdom": "20.0.0",
    "lerna": "5.4.3",
    "oxlint": "^1.60.0",
    "oxlint-plugin-eslint": "^1.60.0",
    "prettier": "^2.7.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sinon": "13.0.1",
    "storybook": "^10.3.5",
    "ts-node": "10.7.0",
    "tsd": "0.19.1",
    "tslib": "^2.4.0",
    "typescript": "4.6.2",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">= 22",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@web-react/utils": "workspace:*",
      "@web-react/lib-config": "workspace:*",
      "@web-react/react-hooks": "workspace:*",
      "@web-react/react-signals": "workspace:*"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "productName": "Web React"
}
