{
  "name": "@web-react/vite-markdown-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "repository": "git@github.com:bichikim/web-react.git",
  "author": "bihci@live.co.kr",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
