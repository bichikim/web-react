{
  "name": "@web-react/react-hooks",
  "version": "0.0.1",
  "repository": "git@github.com:bichikim/web-react.git",
  "author": "bihci@live.co.kr",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./use-*": {
      "types": "./dist/use-*/index.d.ts",
      "import": "./dist/use-*/index.js",
      "require": "./dist/use-*/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "jsdelivr": "dist/index.iife.js",
  "unpkg": "dist/index.iife.js",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "use-*": [
        "dist/use-*/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite dev"
  },
  "dependencies": {
    "@web-react/utils": "workspace:*",
    "es-toolkit": "^1.45.1",
    "esm-env": "^1.2.2",
    "immer": "^9.0.21",
    "react": "^19.2.5",
    "react-fast-compare": "^3.2.2",
    "react-use": "^17.6.0"
  },
  "peerDependencies": {
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@web-react/lib-config": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "1a40cb6a97ad084c8d9244e74cc3fefdca03504f"
}
